# Copy to .env and fill in real values. Never commit .env.

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Splunk HEC
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_TOKEN=
# Set to "true" only for local Splunk with a self-signed cert
SPLUNK_INSECURE_TLS=false

# Alerting (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# Server
PORT=3000
